# Syndicate backend environment template.
# Copy to /etc/syndicate/<service>.env on a host; never commit real secrets.

APP_ENV=localnet
SOLANA_CLUSTER=localnet
LOG_LEVEL=info

DATABASE_URL=postgres://syndicate:syndicate@127.0.0.1:5432/syndicate_local
REDIS_URL=redis://127.0.0.1:6379/0
NATS_URL=nats://127.0.0.1:4222

ACTION_FEED_HOST=127.0.0.1
ACTION_FEED_PORT=8787
ACTION_FEED_OBJECT_STORE_DIR=/var/lib/syndicate/replays
OBJECT_STORE_BUCKET=syndicate-replays
OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORE_REGION=local

SOLANA_RPC_URL_PRIMARY=http://127.0.0.1:8899
SOLANA_RPC_URL_SECONDARY=
SOLANA_RPC_TIMEOUT_MS=5000
SYNDICATE_PROGRAM_ID=REPLACE_WITH_DEPLOYED_PROGRAM_ID
CHIPS_TOKEN_MINT=REPLACE_WITH_CHIPS_SPL_MINT
PROTOCOL_STATE_PDA=REPLACE_WITH_PROTOCOL_STATE_PDA

PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_API_KEY=REPLACE_WITH_SECRET
PYTH_RECEIVER_PROGRAM_ID=rec2HHDDnjLfj4kE7VyEtFA1HPGQLK33259532cRyHp
PYTH_WORMHOLE_PROGRAM_ID=HDw2E7P8X1SkCyjvoGsfBGAVUutKcj874bXjHrpVYrVL
PYTH_PUSH_ORACLE_PROGRAM_ID=pyt2F414BA6dPttK6RddPZUdHfapoBN24GL5wbrPCou
PYTH_PRICE_FEEDS=BTC_USD:0xe62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43,ETH_USD:0xff61491a931112ddf1bd8147cd1b641375f79f5825126d665480874634fd0ace,SOL_USD:0xef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d
DEFAULT_ORACLE_DELAY_WINDOW_SEC=5
DEFAULT_GEOFENCE_BLOCKLIST=IN

DRAND_API=https://api.drand.sh
DRAND_CHAIN_HASH=52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971
DRAND_EXPECTED_SCHEME_ID=bls-unchained-g1-rfc9380
TIMELOCK_GRACE_SEC=30
TIMELOCK_HTTP_TIMEOUT_MS=5000

SETTLEMENT_WORKER_MODE=production
SETTLEMENT_WORKER_HOST=0.0.0.0
SETTLEMENT_WORKER_PORT=8084
SETTLEMENT_STREAM_NAME=SETTLEMENT
SETTLEMENT_CONSUMER_NAME=settlement-worker
SETTLEMENT_RELAY_POLL_MS=1000
SETTLEMENT_RELAY_BATCH_SIZE=16
SETTLEMENT_RELAY_VISIBILITY_MS=60000
SETTLEMENT_RELAY_RETRY_MS=5000
SETTLEMENT_RELAY_MAX_ATTEMPTS=10
SETTLEMENT_POLLER_INTERVAL_MS=5000
SETTLEMENT_POLLER_BATCH_SIZE=16
SETTLEMENT_ACK_WAIT_MS=60000
SETTLEMENT_MAX_DELIVER=10
SETTLEMENT_CHAIN_URL=http://127.0.0.1:8790
SETTLEMENT_CHAIN_HOST=127.0.0.1
SETTLEMENT_CHAIN_PORT=8790
SETTLEMENT_CHAIN_AUTH_TOKEN_FILE=/etc/syndicate/settlement-chain.token
SETTLEMENT_SIGNER_KEYPAIR_PATH=/etc/syndicate/settlement-admin-keypair.json
SETTLEMENT_TX_MAX_RETRIES=5
SETTLEMENT_CONFIRMATION_TIMEOUT_MS=60000
PYTH_ALLOW_TWO_STEP_FALLBACK=true
SETTLEMENT_COMPUTE_UNIT_PRICE_MICRO_LAMPORTS=100000
SETTLEMENT_SUBMIT_COMPUTE_UNITS=200000

ORCHESTRATOR_URL=http://127.0.0.1:8086
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8086
# Set to 1 for local dev when settlement-chain / match-engine are not running.
SYNDICATE_ORCHESTRATOR_STUB=0

OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
PROMETHEUS_URL=http://127.0.0.1:9090
GRAFANA_URL=http://127.0.0.1:3000
