[Unit]
Description=Syndicate Action Feed API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=syndicate
Group=syndicate
WorkingDirectory=/opt/syndicate/backend
EnvironmentFile=/etc/syndicate/action-feed.env
ExecStart=/usr/bin/env node --experimental-strip-types services/action-feed/src/main.ts
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/syndicate /var/log/syndicate

[Install]
WantedBy=multi-user.target
