# Syndicate v2 reverse proxy (nginx container template — ${DOMAIN} is envsubst'd by the
# official nginx image's docker-entrypoint from /etc/nginx/templates).
#
# Routes:
#   api.${DOMAIN}    -> game-server:8080   (REST + WebSocket at /v1/ws)
#   price.${DOMAIN}  -> signed-price-server:8080 (read-only public price feed)
#
# TLS: certbot webroot at /var/www/certbot; certs under /etc/letsencrypt. Until the first
# cert is issued the 443 blocks will fail to load — bring the stack up with only the :80
# server (comment the 443 blocks), issue certs, then re-enable. See DEPLOYMENT.md.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# --- ACME + redirect ---------------------------------------------------------------
server {
    listen 80;
    server_name api.${DOMAIN} price.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# --- game-server: REST + WS --------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name api.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/api.${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.${DOMAIN}/privkey.pem;

    client_max_body_size 256k;

    location /v1/ws {
        proxy_pass http://game-server:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        proxy_pass http://game-server:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- signed-price-server: public read-only ------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name price.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/api.${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.${DOMAIN}/privkey.pem;

    location /ws {
        proxy_pass http://signed-price-server:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    location / {
        # Read-only endpoints only.
        limit_except GET HEAD OPTIONS { deny all; }
        proxy_pass http://signed-price-server:8080;
        proxy_set_header Host $host;
    }
}
