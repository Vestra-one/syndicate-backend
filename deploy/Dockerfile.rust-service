FROM rust:1-bookworm AS builder

WORKDIR /opt/syndicate/backend
COPY Cargo.toml Cargo.lock ./
COPY services ./services
ARG PACKAGE
ARG BIN
RUN cargo build --release -p ${PACKAGE} --bin ${BIN}

FROM debian:bookworm-slim
ARG BIN
ENV BIN=${BIN}
RUN useradd --system --home /var/lib/syndicate --create-home syndicate
COPY --from=builder /opt/syndicate/backend/target/release/${BIN} /usr/local/bin/${BIN}
USER syndicate
CMD ["/bin/sh", "-c", "${BIN}"]
