# Syndicate — backend subdomains (satoshitable.fun)
# Frontend (satoshitable.fun, www.satoshitable.fun) is hosted on Netlify — NOT here.
# Caddy handles the four *.devnet.satoshitable.fun backend subdomains only.
# Install: sudo cp deploy/caddy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
# Guide: docs/deployment/04_DOMAIN_AND_TLS.md
#
# Dev access setup (one-time, on the server):
#   export DEVNET_AUTH_USER=dev
#   export DEVNET_AUTH_PASS_HASH=$(caddy hash-password --plaintext "choose-a-password")
#   # Then persist those two vars in /etc/caddy/caddy.env (or systemd EnvironmentFile)
#
# Frontend .env.local:
#   VITE_DEVNET_AUTH=dev:choose-a-password   # pass as Authorization: Basic header

{
	email hello@satoshitable.fun
}

# CORS + preflight snippet.
# Echoes back the exact Origin (required for credentials mode).
# Allowed: localhost dev servers (any port) + Netlify production frontend.
# Each site block adds auth + proxy in a catch-all handle block.
# CORS OPTIONS preflights are answered before auth — browsers never send
# credentials on preflight so basicauth would always 401 them.
(cors_devnet) {
	@cors_allowed header_regexp cors_orig Origin "^(https?://localhost(:[0-9]+)?|https://(www\.)?satoshitable\.fun)$"

	header @cors_allowed {
		Access-Control-Allow-Origin  "{http.request.header.Origin}"
		Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
		Access-Control-Allow-Credentials "true"
		Vary "Origin"
	}

	@preflight {
		method OPTIONS
		header_regexp cors_pre Origin "^(https?://localhost(:[0-9]+)?|https://(www\.)?satoshitable\.fun)$"
	}
	handle @preflight {
		respond "" 204
	}
}

# Gateway WebSocket
gateway.devnet.satoshitable.fun {
	import cors_devnet
	handle {
		basicauth {
			{env.DEVNET_AUTH_USER} {env.DEVNET_AUTH_PASS_HASH}
		}
		encode gzip zstd
		reverse_proxy 127.0.0.1:18081
	}
}

# Action-feed REST (history, discovery, profiles)
api.devnet.satoshitable.fun {
	import cors_devnet
	handle {
		basicauth {
			{env.DEVNET_AUTH_USER} {env.DEVNET_AUTH_PASS_HASH}
		}
		encode gzip zstd
		reverse_proxy 127.0.0.1:18080
	}
}

# Config REST (table terms, tiers, catalog)
config.devnet.satoshitable.fun {
	import cors_devnet
	handle {
		basicauth {
			{env.DEVNET_AUTH_USER} {env.DEVNET_AUTH_PASS_HASH}
		}
		encode gzip zstd
		reverse_proxy 127.0.0.1:18085
	}
}

# Signed-price feed — read-only public surface (live ticker /ws + historical /prices/at).
# Loopback offset port 18088 (docker-compose.app.yml). NOT on generic host :8080.
# /internal/* (failover admin — UNAUTHENTICATED on devnet) and /metrics are blocked from public.
# The server already returns `Access-Control-Allow-Origin: *`; do NOT add a CORS header here
# (duplicate ACAO: * breaks browsers).
price.devnet.satoshitable.fun {
	encode gzip zstd
	@ops path /internal/* /metrics
	respond @ops 404
	reverse_proxy 127.0.0.1:18088
}
