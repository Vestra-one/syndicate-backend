# Syndicate — backend subdomains (satoshitable.fun)
# Frontend (satoshitable.fun, www.satoshitable.fun) is hosted on Netlify — NOT here.
# Caddy handles the four *.devnet.satoshitable.fun backend subdomains only.
# Install: sudo cp deploy/caddy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
# Guide: docs/deployment/04_DOMAIN_AND_TLS.md

{
	email hello@satoshitable.fun
}

# Gateway WebSocket
gateway.devnet.satoshitable.fun {
	encode gzip zstd
	reverse_proxy 127.0.0.1:18081
}

# Action-feed REST (history, discovery, profiles)
api.devnet.satoshitable.fun {
	encode gzip zstd
	reverse_proxy 127.0.0.1:18080
}

# Config REST (table terms, tiers, catalog)
config.devnet.satoshitable.fun {
	encode gzip zstd
	reverse_proxy 127.0.0.1:18085
}

# Signed-price feed — read-only public surface (live ticker /ws + historical /prices/at).
# Loopback offset port 18088 (docker-compose.app.yml). NOT on generic host :8080.
# /internal/* (failover admin — UNAUTHENTICATED on devnet) and /metrics are blocked from public.
# The server already returns `Access-Control-Allow-Origin: *`; do NOT add a CORS header here
# (duplicate ACAO: * breaks browsers).
price.devnet.satoshitable.fun {
	encode gzip zstd
	@ops path /internal/* /metrics
	respond @ops 404
	reverse_proxy 127.0.0.1:18088
}
