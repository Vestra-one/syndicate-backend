FROM rust:1-bookworm AS builder

WORKDIR /opt/syndicate/backend
COPY Cargo.toml Cargo.lock ./
COPY services ./services
RUN cargo build --release -p syndicate-worker

FROM debian:bookworm-slim
RUN useradd --system --home /var/lib/syndicate --create-home syndicate
WORKDIR /opt/syndicate/backend
COPY --from=builder /opt/syndicate/backend/target/release/syndicate-worker /usr/local/bin/syndicate-worker
USER syndicate
CMD ["syndicate-worker"]
