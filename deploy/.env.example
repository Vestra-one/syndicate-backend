# Syndicate v2 stack configuration.
# Copy to deploy/.env and fill in. Secrets (keys, passwords) live as FILES under
# deploy/secrets/ (see deploy/secrets/README.md) — never in this file.

# --- Global --------------------------------------------------------------------------
APP_ENV=devnet                      # devnet | mainnet | localnet
DOMAIN=devnet.satoshitable.fun      # api.$DOMAIN + price.$DOMAIN must point at this host
LOG_LEVEL=info                      # trace|debug|info|warn|error
LOG_FORMAT=json

# --- Postgres ------------------------------------------------------------------------
POSTGRES_USER=syndicate
POSTGRES_DB=syndicate
# password: deploy/secrets/postgres-password (file)

# --- Solana --------------------------------------------------------------------------
SOLANA_RPC_URL_PRIMARY=https://api.devnet.solana.com
SOLANA_RPC_URL_SECONDARY=           # optional second-opinion RPC (paid RPC on mainnet)
SYNDICATE_PROGRAM_ID=91BSZ2pEGCk7Scq9bnfTwrHCYGo8CzGBq5mbpKHAR5FK
# Chip-token allowlist: the ONLY SPL mints accepted as a match's bet token. The backend
# rejects any create whose mint is outside this set (the contract is token-agnostic, so
# this is the sole gate). First entry is the FE default. CSV of base58 mints.
CHIPS_TOKEN_MINTS=3Gdd9ew2Dq63QeJETc7krKB2JJ1GaHfBZvMzBdAy541X
# Legacy single-mint var — still honored as a one-entry fallback when CHIPS_TOKEN_MINTS is unset.
CHIPS_TOKEN_MINT=3Gdd9ew2Dq63QeJETc7krKB2JJ1GaHfBZvMzBdAy541X
TREASURY_TOKEN_ACCOUNT=             # SPL token account receiving withdraw_fees

# --- chain-worker --------------------------------------------------------------------
# operator keypair: deploy/secrets/operator-keypair.json (file; holds settlement_admin +
# config_admin + emergency_void_admin + treasury_admin roles on devnet)
CHAIN_JOBS_POLL_MS=1000
SETTLEMENT_CONFIRMATION_TIMEOUT_MS=60000
SETTLEMENT_CU_PRICE_MICRO_LAMPORTS=100000
MIN_SIGNER_SOL=0.5

# --- drand timelock (League of Entropy quicknet) ---------------------------------------
DRAND_API=https://api.drand.sh
DRAND_CHAIN_HASH=52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971
TIMELOCK_GRACE_SEC=300

# --- signed-price-server ---------------------------------------------------------------
# secp256k1 signing key: deploy/secrets/price-signer.key (file). Its Ethereum address is
# registered on-chain via set_price_signer at protocol init.

# --- game-server -----------------------------------------------------------------------
# session token key: deploy/secrets/session-signing-key (file, 32 random bytes hex)
ADMIN_TOKENS=                       # comma-separated static bearer tokens for /v1/admin/*
CORS_ALLOWED_ORIGINS=https://satoshitable.fun,http://localhost:3000
GEOFENCE_BLOCKLIST=IN

# --- TLS -------------------------------------------------------------------------------
TLS_EMAIL=ops@satoshitable.fun      # certbot registration email

# --- house table (optional) --------------------------------------------------------------
# Bots that keep one public table open so the lobby is never empty. Provision with
# scripts/house-bots-setup.sh (writes HOUSE_BOT_WALLETS; keys: deploy/secrets/house-bot-{1,2}.json).
HOUSE_BOT_WALLETS=                  # CSV of the bots' wallets; the UI labels them "House bot"
HOUSE_BUY_IN=10000000               # chip base units (10 USDC at 6 decimals)
HOUSE_STREET_SEC=30
HOUSE_ROUND_COUNT=3
HOUSE_FILL_SEC=600                  # an empty table is replaced after this long
HOUSE_HUMAN_SEATS=1                 # 1 = a visitor who sits down is playing within seconds
HOUSE_PLAY_WITHOUT_HUMANS=true      # false on mainnet: empty tables refund instead of paying rake
HOUSE_SEAL_MODE=live                # must match the worker's timelock mode (live | mock)
