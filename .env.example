# Realtime gateway (WebSocket). Leave UNSET to run fully in play-money demo mode
# (mock match emulator + demo wallet/chain/tlock). Set it to use the live backend.
VITE_GATEWAY_WS_URL=

# Solana custody (live mode only)
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_PROGRAM_ID=
VITE_CHIPS_TOKEN_MINT=

# drand time-lock beacon (quicknet). Defaults baked into protocol.ts; override per env if needed.
VITE_DRAND_API=https://api.drand.sh
VITE_DRAND_CHAIN_HASH=52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971
