# Satoshi's Table — frontend environment. Copy to `.env.local` (git-ignored) and edit.
# Only VITE_* variables reach the browser bundle.

# --- Backend (syndicate-backend game-server) ------------------------------------------
# REST base — must end in /v1.
VITE_API_URL=https://api.devnet.satoshitable.fun/v1
# Realtime gateway (lobby, match snapshots, turns, acts).
VITE_WS_URL=wss://api.devnet.satoshitable.fun/v1/ws
# Signed price stream — drives the price cabinet chart and seeds the seal input.
VITE_PRICE_WS_URL=wss://price.devnet.satoshitable.fun/ws

# --- Solana -----------------------------------------------------------------------------
# The public devnet endpoint rate-limits hard; use a keyed RPC (Helius/QuickNode/…) for
# anything beyond a quick look.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional — defaults to the program address baked into src/lib/idl/syndicate_program.json.
VITE_PROGRAM_ID=
# Optional fallback only. The chip mint normally comes from the server: each match carries
# its own mint and `GET /v1/config` supplies the default.
VITE_CHIPS_TOKEN_MINT=

# --- Local development ------------------------------------------------------------------
# Full offline stack: run `scripts/localnet/up.sh` in syndicate-backend and paste the block
# it prints. Add this line too — the local worker opens mock (not drand) timelocks. It is
# honored ONLY when VITE_SOLANA_RPC_URL points at localhost; real clusters always use drand.
# VITE_TIMELOCK_MODE=mock

# Devnet debugging: send placeholder intent signatures instead of prompting the wallet.
# Works only against a server started with SYNDICATE_ALLOW_DEV_SIGNATURES=1.
# VITE_DEV_SIGNATURES=1
