# Rust build artifacts.
# NOTE: in some mounted/dev environments the working dir rejects cargo's temp-file
# ops; build with the target dir off-mount, e.g.  CARGO_TARGET_DIR=$HOME/syndicate-target
/target/
target/
/syndicate-target/

# TypeScript / Node (edge services)
node_modules/
dist/
*.tsbuildinfo

# Logs, env, secrets
*.log
.env
.env.*
!deploy/.env.example
*.key
*.pem
# Deployment secrets — everything under deploy/secrets except docs/examples
deploy/secrets/*
!deploy/secrets/README.md
!deploy/secrets/*.example
*.token

# Program deploy keypairs (devnet program id keypair — keep off git)
services/programs/keys/

# Local offline stack state (scripts/localnet): ledger, logs, pids, keys, env
.localnet/

# AI assistant instruction files stay local
CLAUDE.md
AGENTS.md
.cursorignore
.cursorindexingignore

# Local tooling and scratch
.claude/
apps/web/_to_delete/
*.tsbuildinfo

# Test wallets are generated by scripts/localnet/up.sh — never commit keys
deploy/e2e-keys/
